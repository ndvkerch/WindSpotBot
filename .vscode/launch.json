{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "WindSpotBot - Запуск бота",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/src/bot.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": []
        },
        {
            "name": "WindSpotBot - Тесты",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "tests/",
                "-v"
            ]
        }
    ]
}


